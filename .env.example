# Habify Environment Configuration Template
# Copy this file to .env and set your custom values for production

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/habify_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT Security
# Ensure this is a 256-bit (or higher) cryptographic key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Email Delivery (Gmail SMTP with Google App Password)
# If left blank, verification and reset links are logged to console for frictionless local dev
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Application Host URL
APP_BASE_URL=http://localhost:8080
